# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file - it is listed in .gitignore.

# --- Django ---
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- SMS provider ---
# "console" = test mode (nothing is sent, no credits used)
# "textbee" = real SMS through the textbee.dev Android gateway
SMS_PROVIDER=console

# Default country code used to convert local numbers (09XXXXXXXXX -> +639XXXXXXXXX)
SMS_DEFAULT_COUNTRY_CODE=63

# Seconds to wait for the provider before showing a network error
SMS_REQUEST_TIMEOUT=15

# --- textbee.dev credentials (from https://app.textbee.dev/dashboard) ---
TEXTBEE_API_KEY=your-textbee-api-key-here
TEXTBEE_DEVICE_ID=your-textbee-device-id-here
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
